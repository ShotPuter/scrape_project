# Copy to .env.res on a fresh installation. Never commit real credentials.
WEBSHARE_API_TOKEN=
ABUSEIPDB_API_KEY=
# This matches the successful live check: mandatory shared blocklists, no per-IP CHECK.
PROXY_REPUTATION_MODE=blocklist_only
RES_DATA_DIR=./data
RES_START_DATE=2025-07-29
RES_END_DATE=2025-07-29
RES_BULK_RUN_ID=res-bulk-2025-07-29
RES_BULK_PROXY_PROVIDER=webshare
RES_BULK_PROXY_INDEX=0
RES_BULK_KIND=action
RES_BULK_LIMIT=100
RES_BULK_MAX_TOKENS=4
RES_BULK_WORKERS=4
RES_BULK_INTERVAL=0.1
RES_CAPTCHA_TIMEOUT=130
RES_AUDIO_THREADS=2
RES_MEMORY_LIMIT=6g
RES_CPUS=4
RES_SHM_SIZE=2gb
