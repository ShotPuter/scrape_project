# Copy to .env.res on a fresh installation. Never commit real credentials.
WEBSHARE_API_TOKEN=
ABUSEIPDB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RES_TELEGRAM_INTERVAL_MINUTES=5
# This matches the successful live check: mandatory shared blocklists, no per-IP CHECK.
PROXY_REPUTATION_MODE=blocklist_only
RES_DATA_DIR=./data
RES_CONTINUOUS_FROM_DATE=2013-01-01
RES_CONTINUOUS_RUN_ID=res-continuous
RES_CONTINUOUS_PROVIDERS=webshare,brightdata,residential
# Optional additional provider, attempted only after transport failures.
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
# An optional private list of proxies: data/residential-proxies.txt.
RES_BULK_KIND=action
# 0 drains the queue with no artificial per-cycle document/token budget.
RES_BULK_BATCH_SIZE=0
RES_BULK_QUOTA_HOURS=24
RES_BULK_NETWORK_RETRY_SECONDS=10
RES_BULK_WORKERS=4
RES_BULK_INTERVAL=0.1
RES_CAPTCHA_TIMEOUT=130
RES_AUDIO_THREADS=2
RES_MEMORY_LIMIT=6g
RES_CPUS=4
RES_SHM_SIZE=2gb
