# Copy to .env.res and supply your own Webshare API token.
WEBSHARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RES_TELEGRAM_INTERVAL_MINUTES=5
RES_DATA_DIR=./data
RES_SEARCH_RUN_ID=res-companies-100
RES_LIMIT=100
RES_YEAR=2025
RES_MONTH=1
# inherit: same provider as RES; direct: DeQuienes only uses the server connection.
RES_COLLECT_PROXY_PROVIDER=inherit
RES_BROWSERS=5
RES_TABS_PER_BROWSER=2
RES_RATE_PER_MINUTE=6
RES_CHECKPOINT_INTERVAL=15
RES_SHM_SIZE=2gb
RES_MEMORY_LIMIT=12g
RES_CPUS=6
