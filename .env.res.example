# Copy to .env.res. Secrets are injected at runtime and are never copied into the image.
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
RES_PROXY_PROVIDER=brightdata
# Optional alternative provider; not used when RES_PROXY_PROVIDER=brightdata.
WEBSHARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RES_TELEGRAM_INTERVAL_MINUTES=5
RES_DATA_DIR=./data
RES_RUN_ID=res-2025-01-100
RES_YEAR=2025
RES_MONTH=1
RES_LIMIT=100
# Independent Camoufox processes, one CAPTCHA tab per browser.
RES_BROWSERS=2
# 0 downloads every CVE found for a company; 1 is useful for a short speed sample.
RES_MAX_DOCUMENTS=0
# 0 calculates a finite budget from queue size. Sessions are created only when needed.
RES_PROXY_SESSIONS=0
RES_TOKENS_PER_PROXY=20
RES_COMPANY_ATTEMPTS=2
RES_MAX_FAILURES=20
# One worker reaching the threshold pauses the entire batch; 0 minutes disables pauses.
RES_ERROR_COOLDOWN_MINUTES=10
# Shared pause budget per launch; after it is spent another error streak stops the queue.
RES_MAX_COOLDOWNS=3
RES_TIMEOUT=40
# Widget loading and audio solve budgets; independent of HTTP timeouts.
RES_CAPTCHA_TIMEOUT=130
RES_DELAY=3
RES_AUDIO_THREADS=2
RES_CHECKPOINT_INTERVAL=15
# Normal restart resumes unfinished work; set 1 to also retry saved failures.
RES_RETRY_ERRORS=0
RES_SHM_SIZE=2gb
RES_MEMORY_LIMIT=12g
RES_CPUS=6
RES_PIDS_LIMIT=4096

# Passive reputation check before connecting to any configured proxy.
# Get a free API key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# strict: CHECK last; blocklist_only: no individual CHECK requests.
PROXY_REPUTATION_MODE=strict
PROXY_REPUTATION_SCORE_LIMIT=25
# Conservative: deny any IP with reports in the last 30 days.
PROXY_REPUTATION_MAX_REPORTS=0
PROXY_REPUTATION_CACHE_HOURS=6
# Shared DROP / bulk blacklist snapshots (hours). Never grants permission by absence.
PROXY_BLOCKLIST_REFRESH_HOURS=24
PROXY_BLOCKLIST_MAX_AGE_HOURS=48
# Mandatory FireHOL and NoCoin snapshots, in both reputation modes.
PROXY_THREAT_REFRESH_HOURS=6
PROXY_THREAT_MAX_AGE_HOURS=12
PROXY_THREAT_CACHE=data/threat-feeds
ALLOW_PUBLIC_PROXY_COLLECTION=0

# Explicit continuous free-proxy mode: also pass -f compose.res.free.yml.
# It uses at most five browsers, one token page per browser. All discovery is HTTP.
RES_FREE_SOURCES=all
RES_FREE_BATCH_SIZE=10
RES_FREE_CHECK_CONCURRENCY=12
RES_FREE_CHECK_RATE_PER_MINUTE=120
RES_FREE_READY_CAPACITY=20
RES_FREE_PROXY_RETRY_SECONDS=300
RES_FREE_CATALOG_SECONDS=600
# 0 waits indefinitely for eligible proxies; otherwise checkpoint and stop after idle.
RES_FREE_IDLE_MINUTES=0
RES_FREE_WORKER_TIMEOUT=1800
# Nonstandard ports require identical exact IP:port grants in the host firewall.
RES_FREE_ALLOWED_PROXY_ENDPOINTS=
RES_FREE_MAX_COOLDOWNS=0
RES_FREE_SITE_LIMIT_HOURS=24

# Full statistics for free-stream; lifecycle events arrive immediately/batched.
RES_FREE_TELEGRAM_INTERVAL_MINUTES=30
