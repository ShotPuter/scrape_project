# Copy to .env.res. Secrets are injected at runtime and are never copied into the image.
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
RES_PROXY_PROVIDER=brightdata
# Optional alternative provider; not used when RES_PROXY_PROVIDER=brightdata.
WEBSHARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RES_TELEGRAM_INTERVAL_MINUTES=5
RES_DATA_DIR=./data
RES_RUN_ID=res-2025-01-100
RES_YEAR=2025
RES_MONTH=1
RES_LIMIT=100
# Independent Camoufox processes, one CAPTCHA tab per browser.
RES_BROWSERS=2
# 0 downloads every CVE found for a company; 1 is useful for a short speed sample.
RES_MAX_DOCUMENTS=0
# 0 calculates a finite budget from queue size. Sessions are created only when needed.
RES_PROXY_SESSIONS=0
RES_TOKENS_PER_PROXY=20
RES_COMPANY_ATTEMPTS=2
RES_MAX_FAILURES=20
RES_TIMEOUT=40
RES_DELAY=3
RES_AUDIO_THREADS=2
RES_CHECKPOINT_INTERVAL=15
# Normal restart resumes unfinished work; set 1 to also retry saved failures.
RES_RETRY_ERRORS=0
RES_SHM_SIZE=2gb
RES_MEMORY_LIMIT=12g
RES_CPUS=6
RES_PIDS_LIMIT=4096
