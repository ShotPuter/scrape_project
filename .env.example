# ==============================================================================
# Gaceta de Comercio (SEPREC) Scraper Configuration
# Copy this file to `.env` and adjust values as needed.
# ==============================================================================

# API endpoints
SEPREC_API_BASE_URL=https://servicios.seprec.gob.bo/api

# HTTP transport: aiohttp (primary) with automatic curl_cffi fallback.
HTTP_TRANSPORT=aiohttp

# Concurrency & performance
# One shared cap for API pages, document requests AND proxy probes.
MAX_CONCURRENT_REQUESTS=15
# Second scrape phase: publication detail + file writes.
PAGE_SIZE=50
PAGE_DELAY_SECONDS=0.5
# API total; document total is longer because PDFs arrive inside base64 JSON.
REQUEST_TIMEOUT_SECONDS=30
DETAIL_TIMEOUT_SECONDS=90
CONNECT_TIMEOUT_SECONDS=10
SOCK_CONNECT_TIMEOUT_SECONDS=10
SOCK_READ_TIMEOUT_SECONDS=30
# Request start rate across the process; 0 disables pacing. Also used by collector.
HTTP_REQUESTS_PER_SECOND=2
# Bounded in-memory queue and soft persistent backlog watermark (one page overshoot).
QUEUE_HIGH_WATERMARK=1000
METRICS_INTERVAL_SECONDS=60
RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=1.5
RETRY_JITTER_SECONDS=0.3

# Scheduler (used by `python main.py --schedule`)
SCHEDULE_INTERVAL_HOURS=24

# Storage (relative paths are resolved against the project root)
STORAGE_BASE_DIR=./data
PDF_STORAGE_DIR=./data/pdf
CSV_EXPORT_PATH=./data/publications.csv

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=./data/scraper.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# curl_cffi supplies a User-Agent matching this browser profile.
BROWSER_PROFILE=chrome
# Optional override; normally leave empty to match the browser fingerprint.
USER_AGENT=
# Optional custom CSV. CLI otherwise uses PROXY_LIST_PATH; empty does not force direct mode.
PROXY_FILE=
# Routing when proxies are configured:
#   direct   = never use proxies (fastest if the site does not block your IP)
#   fallback = direct requests first; proxies only after 403/407/429 or repeated
#              direct network failures (probes warm up in background)
#   pool     = proxy pool first; direct only when the pool has no usable sessions
#              (recommended when the origin blacklists the direct IP)
#   always   = every request goes through the proxy pool (classic proxy-only mode)
PROXY_MODE=pool
# How long (seconds) the direct route is set aside after a block before probing again.
DIRECT_BLOCK_COOLDOWN_SECONDS=300
# Verified proxy database produced by `python collect_proxies.py`.
# The collector uses ProxyScrape, HProxy and Proxifly by default (`--provider public`).
# `--provider both` keeps the older iplocate + free-proxy behavior; `--provider all`
# combines all five. On success it deletes old rows, writes only fresh verified
# proxies, and removes the <db>.dead.json sidecar. main.py uses this database
# by default when automatic proxy refresh is enabled.
PROXY_DB_PATH=./data/proxies.db
# The upstream list is refreshed at most once per interval (GitHub updates every ~30 min).
PROXY_SOURCE_URL=https://raw.githubusercontent.com/iplocate/free-proxy-list/main/all-proxies.txt
PROXY_LIST_PATH=./data/iplocate-proxies.csv
PROXY_STATE_PATH=./data/iplocate-proxies.state.json
PROXY_SOURCE_REFRESH_MINUTES=30
PROXY_SOURCE_TIMEOUT=30
# 0 = all active unique proxies; N > 0 = only the N fastest by measured latency.
PROXY_SAMPLE_SIZE=0
# Standalone collector workers; scraper probes have their own small limit below.
PROXY_CHECK_CONCURRENCY=50
PROXY_PROBE_CONCURRENCY=2
PROXY_PER_IP_LIMIT=1
# Includes waiting for a busy proxy and cooldown; separate from request timeouts.
PROXY_ACQUIRE_TIMEOUT=150
PROXY_CHECK_TIMEOUT=10

# Multi-source catalog and two-stage collector (collect_proxies.py).
# 0 = no cap. Caps are applied after metadata filtering and priority sorting.
PROXY_MAX_CANDIDATES=2000
PROXY_MAX_PER_SOURCE=1000
# Stage 1: real HTTPS request through the proxy (not a third-party test API).
PROXY_STAGE1_CHECK_URL=https://api.ipify.org?format=json
PROXY_STAGE1_TIMEOUT=10
PROXY_STAGE1_CONNECT_TIMEOUT=5
PROXY_STAGE1_MIN_UPTIME=80
PROXY_STAGE1_MAX_LATENCY_MS=1500
# Prefer fresh metadata; hard-reject only clearly stale entries.
PROXY_STAGE1_PREFERRED_AGE_MINUTES=15
PROXY_STAGE1_MAX_AGE_MINUTES=1440
# Ambiguous https=false metadata only lowers priority; the real HTTPS check decides.
PROXY_STAGE1_REQUIRE_HTTPS=true
# Stage 2: real Gaceta catalog + publication-search API checks.
PROXY_STAGE2_CONCURRENCY=20
PROXY_STAGE2_TIMEOUT=30
PROXY_STAGE2_CONNECT_TIMEOUT=10
PROXY_STAGE2_ATTEMPTS=3
PROXY_STAGE2_RETRY_DELAY=0.5
PROXY_STAGE2_MAX_RETRY_DELAY=5
PROXY_STAGE2_REQUESTS_PER_SECOND=5
PROXY_STAGE2_MIN_SUCCESS_RATE=0
PROXY_STAGE2_MIN_SUCCESSES=1
PROXY_REPORT_PATH=./data/proxy-report.json
# Distinct verified proxies required before a scrape starts. The working pool
# also uses this as its warmup readiness threshold.
PROXY_MIN_READY=20
# Re-check more proxies when the ready pool drops below this value.
PROXY_REPLENISH_THRESHOLD=10
PROXY_FAILURE_COOLDOWN_SECONDS=120
PROXY_MAX_FAILURES=3
PROXY_DEAD_TTL_HOURS=1
# Set to false to use proxies without a startup readiness check.
PROXY_WARMUP=true
# Optional Netscape cookies.txt file (domain/path/expiry are preserved).
COOKIES_FILE=
