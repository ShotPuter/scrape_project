# ==============================================================================
# Gaceta de Comercio (SEPREC) Scraper Configuration
# Copy this file to `.env` and adjust values as needed.
# ==============================================================================

# API endpoints
SEPREC_API_BASE_URL=https://servicios.seprec.gob.bo/api

# HTTP transport: aiohttp (primary) with automatic curl_cffi fallback.
HTTP_TRANSPORT=aiohttp

# Concurrency & performance
# One shared cap for API pages, document requests AND proxy probes.
MAX_CONCURRENT_REQUESTS=15
# Processing workers include retry waits, PDF decoding and disk writes.
# 0 matches MAX_CONCURRENT_REQUESTS; compare 15 vs 30 before raising the HTTP cap.
DOWNLOAD_WORKERS=0
# Second scrape phase: publication detail + file writes.
PAGE_SIZE=50
PAGE_DELAY_SECONDS=0.5
# API total; document total is longer because PDFs arrive inside base64 JSON.
REQUEST_TIMEOUT_SECONDS=30
DETAIL_TIMEOUT_SECONDS=90
CONNECT_TIMEOUT_SECONDS=10
SOCK_CONNECT_TIMEOUT_SECONDS=10
SOCK_READ_TIMEOUT_SECONDS=30
# Scraping request start rate; 0 disables pacing. Collector has its own budget below.
HTTP_REQUESTS_PER_SECOND=2
# Private provider export: one scheme://user:password@host:port per line.
# Selected explicitly with: python -m src.proxy --sources paid
PROXY_PAID_FILE=./data/paid-proxies.txt
# Automatically prefer Webshare proxies; public sources stay as a failure reserve.
# API key from the Webshare dashboard, not its proxy-list download token.
WEBSHARE_API_TOKEN=
# direct for standard proxy plans; backbone for rotating residential plans.
WEBSHARE_PROXY_MODE=direct
# Verify free proxies only after Webshare has been published and its usable pool
# falls to this many distinct URLs (inclusive). No free-source traffic above it.
WEBSHARE_FREE_FALLBACK_THRESHOLD=10
# Bounded in-memory queue and soft persistent backlog watermark (one page overshoot).
QUEUE_HIGH_WATERMARK=1000
METRICS_INTERVAL_SECONDS=60
RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=1.5
RETRY_JITTER_SECONDS=0.3
# First proxy HTTP 429: exclude its URL for Retry-After and pause globally 150s.
# Three distinct limited URLs in ten minutes trigger the longer server pause.
RATE_LIMIT_PAUSE_SECONDS=150

# Storage (relative paths are resolved against the project root)
STORAGE_BASE_DIR=./data
PDF_STORAGE_DIR=./data/pdf
CSV_EXPORT_PATH=./data/publications.csv

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE=./data/scraper.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# curl_cffi supplies a User-Agent matching this browser profile.
BROWSER_PROFILE=chrome
# Optional override; normally leave empty to match the browser fingerprint.
USER_AGENT=
# Optional proxy CSV/TXT for library callers that do not configure PROXY_DB_PATH.
# The CLI always uses the verified SQLite database instead.
PROXY_FILE=
# Routing when proxies are configured:
#   direct   = never use proxies (fastest if the site does not block your IP)
#   fallback = direct requests first; proxies only after 403/407/429 or repeated
#              direct network failures (probes warm up in background)
#   pool     = proxy pool first; direct only when the pool has no usable sessions
#              (recommended when the origin blacklists the direct IP)
#   always   = every request goes through the proxy pool (classic proxy-only mode)
PROXY_MODE=pool
# How long (seconds) the direct route is set aside after a block before probing again.
DIRECT_BLOCK_COOLDOWN_SECONDS=300
# Verified proxy database produced by `python main.py --collect-proxies`.
# --provider public uses a default subset; --provider all enables every source.
# List names/URLs with `python -m src.proxy --list-sources`.
PROXY_DB_PATH=./data/proxies.db
# Comma-separated names, public, or all. Empty uses the default subset.
# Example: monosans,relayglass,proxyscrape,iplocate
PROXY_SOURCES=
# Start a bounded collector subprocess when the DB is empty. Set false when an
# independent `python -m src.proxy --watch` process manages the database.
PROXY_AUTOCOLLECT=true
# Periodically reload verified DB snapshots into the live pool; 0 disables reload.
PROXY_DB_REFRESH_SECONDS=30
# Per-file cache honors each source's interval and HTTP ETag/Last-Modified.
PROXY_CATALOG_CACHE_DIR=./data/proxy-sources
# Maximum age for offline cache fallback; 0 requires remote revalidation.
PROXY_SOURCE_CACHE_MAX_AGE_HOURS=24
# Limits include decompressed response bytes and candidates per downloaded file.
PROXY_SOURCE_MAX_RESPONSE_BYTES=33554432
PROXY_SOURCE_DOWNLOAD_CONCURRENCY=3
PROXY_SOURCE_MAX_RECORDS=10000
# Optional custom iplocate TXT URL and legacy local CSV input.
PROXY_SOURCE_URL=https://raw.githubusercontent.com/iplocate/free-proxy-list/main/all-proxies.txt
PROXY_LIST_PATH=./data/iplocate-proxies.csv
PROXY_STATE_PATH=./data/iplocate-proxies.state.json
PROXY_SOURCE_REFRESH_MINUTES=30
PROXY_SOURCE_TIMEOUT=30
# 0 = all active unique proxies; N > 0 = only the N fastest by measured latency.
PROXY_SAMPLE_SIZE=0
# Standalone collector workers; scraper probes have their own small limit below.
PROXY_CHECK_CONCURRENCY=50
PROXY_PROBE_CONCURRENCY=2
PROXY_PER_IP_LIMIT=1
# Includes waiting for a busy proxy and cooldown; separate from request timeouts.
PROXY_ACQUIRE_TIMEOUT=150
PROXY_CHECK_TIMEOUT=10

# Multi-source catalog and two-stage collector (collect_proxies.py).
# 0 = no cap. Caps are applied after metadata filtering and priority sorting.
PROXY_MAX_CANDIDATES=2000
PROXY_MAX_PER_SOURCE=1000
# Stage 1: real HTTPS request through the proxy (not a third-party test API).
PROXY_STAGE1_CHECK_URL=https://api.ipify.org?format=json
PROXY_STAGE1_TIMEOUT=10
PROXY_STAGE1_CONNECT_TIMEOUT=5
PROXY_STAGE1_MIN_UPTIME=80
PROXY_STAGE1_MAX_LATENCY_MS=1500
# Prefer fresh metadata; hard-reject only clearly stale entries.
PROXY_STAGE1_PREFERRED_AGE_MINUTES=15
PROXY_STAGE1_MAX_AGE_MINUTES=1440
# Ambiguous https=false metadata only lowers priority; the real HTTPS check decides.
PROXY_STAGE1_REQUIRE_HTTPS=true
# Stage 2: one minimal publication-search request per transport attempt.
# The alternate transport is tried only if the preferred one fails.
# After 403 or challenge-like responses, try up to N distinct User-Agents per transport.
# fake-useragent uses bundled desktop data filtered by BROWSER_PROFILE family.
# The explicit USER_AGENT above is tried first. 1 disables User-Agent fallback.
PROXY_USER_AGENT_LIMIT=3
PROXY_STAGE2_CONCURRENCY=20
PROXY_STAGE2_TIMEOUT=30
PROXY_STAGE2_CONNECT_TIMEOUT=10
PROXY_STAGE2_ATTEMPTS=1
PROXY_STAGE2_RETRY_DELAY=0.5
PROXY_STAGE2_MAX_RETRY_DELAY=5
PROXY_STAGE2_REQUESTS_PER_SECOND=5
PROXY_STAGE2_MIN_SUCCESS_RATE=0
PROXY_STAGE2_MIN_SUCCESSES=1
PROXY_REPORT_PATH=./data/proxy-report.json
# Distinct verified proxies required before a scrape starts. The working pool
# also uses this as its warmup readiness threshold.
PROXY_MIN_READY=20
# Re-check more proxies when the ready pool drops below this value.
PROXY_REPLENISH_THRESHOLD=10
PROXY_FAILURE_COOLDOWN_SECONDS=120
PROXY_MAX_FAILURES=3
PROXY_DEAD_TTL_HOURS=1
# Ignore verified records older than this; 0 disables the freshness filter.
PROXY_DB_MAX_AGE_HOURS=24
# Reuse a collector verification this many seconds without a startup/reload probe.
# Older records are checked before use. 0 disables receipt reuse.
PROXY_VERIFIED_REUSE_SECONDS=300
# Startup is bounded: after the warmup timeout the scrape starts with whatever
# proxies are ready (or falls back to direct requests if none are ready).
PROXY_WARMUP_TIMEOUT_SECONDS=90
# Maximum time to wait for a freshly collected database before scraping.
PROXY_STARTUP_TIMEOUT_SECONDS=180
# How long the CLI waits for the collector to stop before killing it.
PROXY_COLLECTOR_STOP_TIMEOUT_SECONDS=5
# Set to false to use proxies without a startup readiness check.
PROXY_WARMUP=true
# Optional Netscape cookies.txt file (domain/path/expiry are preserved).
COOKIES_FILE=

# Optional outgoing Telegram notifications. No public server/HTTPS certificate needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_INTERVAL_SECONDS=1800
