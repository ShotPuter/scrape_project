# Copy to .env on the server. Docker Compose v2.24+ is required.
# Match the owner of DATA_DIR; export SCRAPER_UID=$(id -u) SCRAPER_GID=$(id -g)
# before building when the server user is not UID/GID 1000.
SCRAPER_UID=1000
SCRAPER_GID=1000
DATA_DIR=./data
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPUS=2

# All paths inside the containers are set by docker-compose.yml.
# Set your Webshare API key here. Empty = free proxies only.
WEBSHARE_API_TOKEN=
WEBSHARE_PROXY_MODE=direct
WEBSHARE_FREE_FALLBACK_THRESHOLD=10
PROXY_MODE=always
PROXY_SOURCES=all
PROXY_STARTUP_TIMEOUT_SECONDS=900
PROXY_DB_REFRESH_SECONDS=30
PROXY_MIN_READY=20
PROXY_MAX_CANDIDATES=2000
PROXY_MAX_PER_SOURCE=1000
PROXY_CHECK_CONCURRENCY=50
PROXY_STAGE2_CONCURRENCY=20
PROXY_STAGE2_REQUESTS_PER_SECOND=5
PROXY_PROBE_CONCURRENCY=2
PROXY_PER_IP_LIMIT=1
PROXY_ACQUIRE_TIMEOUT=150

MAX_CONCURRENT_REQUESTS=15
DOWNLOAD_WORKERS=30
HTTP_REQUESTS_PER_SECOND=2
RATE_LIMIT_PAUSE_SECONDS=150
METRICS_INTERVAL_SECONDS=60
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Stress-only controls. PDFs and publication CSV are not written in this mode.
STRESS_YEAR=2022
STRESS_CATEGORY=all
STRESS_MINUTES=480

# Optional outgoing Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_INTERVAL_SECONDS=1800
