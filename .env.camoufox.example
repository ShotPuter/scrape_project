# Path on the server to the already downloaded Excel; it is mounted read-only.
PEP_INPUT=./docs/DECLARACIONES_PEP.xlsx
# Count unique links (0 = all); offset also counts unique links.
PEP_LIMIT=100
PEP_OFFSET=0
PEP_TIMEOUT=60
PEP_MAX_MINUTES=120
PEP_WORKERS=20
PEP_TABS=3
# Replacement pages per tab slot after a close/crash, preserving the browser/proxy.
PEP_TAB_RESTARTS=3
PEP_LOG_INTERVAL=30
# 0 = every 10 completed links; positive value = progress interval in minutes.
PEP_TELEGRAM_INTERVAL_MINUTES=30
PEP_MEMORY_LIMIT=24g
PEP_CPUS=8
PEP_SHM_SIZE=4gb
PEP_PIDS_LIMIT=8192
# webshare: one distinct proxy address per browser, fetched at startup.
# brightdata: one sticky session per browser. auto: prefer Webshare when its key is set.
PEP_PROXY_PROVIDER=webshare
WEBSHARE_API_TOKEN=
# Base zone credentials only; the application adds a separate sticky session per browser.
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
# Optional: without both values, reports appear only in logs/progress.jsonl.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PEP_BROWSER_MAX_MINUTES=20
PEP_BROWSER_MAX_LINKS=40
PEP_SITE_PAUSE_MINUTES=20
PEP_BROWSER_RECOVERIES=3

# Passive reputation check before connecting to any configured proxy.
# Get a free API key at https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# strict: CHECK last; blocklist_only: no individual CHECK requests.
PROXY_REPUTATION_MODE=strict
PROXY_REPUTATION_SCORE_LIMIT=25
# Conservative: deny any IP with reports in the last 30 days.
PROXY_REPUTATION_MAX_REPORTS=0
PROXY_REPUTATION_CACHE_HOURS=6
# Shared DROP / bulk blacklist snapshots (hours). Never grants permission by absence.
PROXY_BLOCKLIST_REFRESH_HOURS=24
PROXY_BLOCKLIST_MAX_AGE_HOURS=48
# Mandatory FireHOL and NoCoin snapshots, in both reputation modes.
PROXY_THREAT_REFRESH_HOURS=6
PROXY_THREAT_MAX_AGE_HOURS=12
PROXY_THREAT_CACHE=data/threat-feeds
ALLOW_PUBLIC_PROXY_COLLECTION=0
