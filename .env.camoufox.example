# Path on the server to the already downloaded Excel; it is mounted read-only.
PEP_INPUT=./docs/DECLARACIONES_PEP.xlsx
# Count unique links (0 = all); offset also counts unique links.
PEP_LIMIT=100
PEP_OFFSET=0
PEP_TIMEOUT=60
PEP_MAX_MINUTES=120
PEP_WORKERS=4
PEP_LOG_INTERVAL=30
PEP_MEMORY_LIMIT=8g
PEP_CPUS=4
PEP_SHM_SIZE=2gb
# Base zone credentials only; the application adds a separate sticky session per browser.
BRIGHTDATA_PROXY_SERVER=http://brd.superproxy.io:44445
BRIGHTDATA_PROXY_USERNAME=
BRIGHTDATA_PROXY_PASSWORD=
# Optional: without both values, reports appear only in logs/progress.jsonl.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
